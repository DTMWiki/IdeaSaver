# Keep /api for same-origin deployment. The image domain should reverse proxy it
# to the existing IdeaSaver Go service.
VITE_API_BASE=/api

# Local Vite proxy target. Change this to the running Go service when needed.
VITE_DEV_API_ORIGIN=http://localhost:8080

# Maximum number of files uploaded at the same time.
VITE_UPLOAD_CONCURRENCY=3
