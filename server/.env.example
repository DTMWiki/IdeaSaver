# IdeaSaver Configuration
# Copy this file to .env and fill in the values

# Server
IDEASAVER_ENV=development
IDEASAVER_PORT=8080

# Database
IDEASAVER_DATABASE_URL=postgres://ideasaver:password@localhost:5432/ideasaver?sslmode=disable

# Authelia OAuth2
IDEASAVER_AUTHELIA_ISSUER=https://auth.dtmwiki.cn
IDEASAVER_AUTHELIA_CLIENT_ID=ideasaver
IDEASAVER_AUTHELIA_CLIENT_SECRET=your-client-secret
IDEASAVER_AUTHELIA_REDIRECT_URL=https://i.dtmwiki.cn/api/auth/callback

# JWT
IDEASAVER_JWT_SECRET=your-jwt-secret-change-this

# DogeCloud OSS (S3 Compatible)
IDEASAVER_DOGE_ACCESS_KEY=your-access-key
IDEASAVER_DOGE_SECRET_KEY=your-secret-key
IDEASAVER_DOGE_BUCKET=your-bucket-name
IDEASAVER_DOGE_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
IDEASAVER_DOGE_REGION=ap-shanghai
IDEASAVER_PUBLIC_BASE_URL=https://i.dtmwiki.cn

# DogeCloud VCloud
IDEASAVER_DOGE_VCLOUD_API=https://api.dogecloud.com

# Upload Settings
IDEASAVER_MAX_UPLOAD_SIZE_MB=10240
IDEASAVER_MAX_CONCURRENT_UPLOADS=10
IDEASAVER_UPLOAD_RATE_LIMIT_MBPS=0

# User Defaults
IDEASAVER_DEFAULT_QUOTA_BYTES=5368709120

# Trash
IDEASAVER_TRASH_RETENTION_DAYS=30
