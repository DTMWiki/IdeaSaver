# IdeaSaver Configuration
# Copy this file to .env and fill in the values

# Server
IDEASAVER_ENV=development
IDEASAVER_PORT=8080

# Database
IDEASAVER_DATABASE_URL=postgres://ideasaver:password@localhost:5432/ideasaver?sslmode=disable

# Authelia OAuth2
IDEASAVER_AUTHELIA_ISSUER=https://auth.dtmwiki.cn
IDEASAVER_AUTHELIA_CLIENT_ID=ideasaver
IDEASAVER_AUTHELIA_CLIENT_SECRET=your-client-secret
IDEASAVER_AUTHELIA_REDIRECT_URL=https://i.dtmwiki.cn/api/auth/callback

# Optional generic OIDC endpoints (set these when using Authentik or other IdP)
# IDEASAVER_OIDC_AUTH_URL=https://auth.example.com/application/o/authorize/
# IDEASAVER_OIDC_TOKEN_URL=https://auth.example.com/application/o/token/
# IDEASAVER_OIDC_USERINFO_URL=https://auth.example.com/application/o/userinfo/
# IDEASAVER_OIDC_SCOPES=openid,profile,email

# JWT
IDEASAVER_JWT_SECRET=your-jwt-secret-change-this

# Comma-separated reverse-proxy IPs/CIDRs trusted for X-Forwarded-For / ClientIP.
# Leave empty to ignore forwarded headers (recommended unless behind a known proxy).
# IDEASAVER_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Video callback auth (required in production; append ?secret=... to DogeCloud callback URL)
IDEASAVER_VIDEO_CALLBACK_SECRET=replace-with-long-random-secret

# DogeCloud OSS (S3 Compatible)
IDEASAVER_DOGE_ACCESS_KEY=your-access-key
IDEASAVER_DOGE_SECRET_KEY=your-secret-key
IDEASAVER_DOGE_BUCKET=your-bucket-name
IDEASAVER_DOGE_ENDPOINT=https://cos.ap-shanghai.myqcloud.com
IDEASAVER_DOGE_REGION=ap-shanghai
IDEASAVER_PUBLIC_BASE_URL=https://i.dtmwiki.cn
# NOTE:
# - The backend prefers s3Bucket/s3Endpoint from DogeCloud tmp-token API when available.
# - IDEASAVER_DOGE_BUCKET / IDEASAVER_DOGE_ENDPOINT are used as fallback values.

# DogeCloud VCloud
IDEASAVER_DOGE_VCLOUD_API=https://api.dogecloud.com
# Optional: fixed DogeCloud user ID for JS player SDK (fallback when callback/info lacks userId)
# IDEASAVER_DOGE_USER_ID=123456

# Upload Settings
IDEASAVER_MAX_UPLOAD_SIZE_MB=10240
# Process-wide concurrent chunk uploads (enforced in UploadService)
IDEASAVER_MAX_CONCURRENT_UPLOADS=10
# Per-stream upload throttle in MB/s (0 = unlimited)
IDEASAVER_UPLOAD_RATE_LIMIT_MBPS=0

# User Defaults
IDEASAVER_DEFAULT_QUOTA_BYTES=5368709120

# Trash
IDEASAVER_TRASH_RETENTION_DAYS=30
