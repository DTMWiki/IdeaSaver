[Unit]
Description=IdeaSaver - DTMWiki File Upload Platform
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=ideasaver
Group=ideasaver
WorkingDirectory=/data/ideasaver
ExecStart=/data/ideasaver/ideasaver
EnvironmentFile=/data/ideasaver/.env
Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ideasaver

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/data/ideasaver
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
